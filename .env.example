# ==============================================================================
# SplyGo Environment Configuration Template
# Duplicate this file to .env and fill in your actual credentials.
# ==============================================================================

# --- 1. Google Cloud Credentials ---
# Note: GOOGLE_API_KEY is standard Google Cloud API key (e.g., for Maps/Places).
# GOOGLE_CLIENT_ID is the OAuth 2.0 Client ID for Google Identity Services (ends with .apps.googleusercontent.com).
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# --- 2. Mapbox Public Access Token ---
# Obtain from https://account.mapbox.com/ (starts with pk.eyJ1...)
MAPBOX_TOKEN=your_mapbox_public_token_here

# --- 3. OpenWeatherMap API Key ---
# Obtain from https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- 4. Server Configuration ---
PORT=8000
HOST=0.0.0.0
